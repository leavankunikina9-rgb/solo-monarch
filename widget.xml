<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#E6030914">
    <TextView android:id="@+id/w_head" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="[!] STATUS" android:textColor="#00E5FF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_rank" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="LEVEL 1" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_job" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="UNAWAKENED" android:textColor="#A000FF" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_goal" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FACC15" android:textSize="12sp" android:layout_marginTop="6dp" />
</LinearLayout>